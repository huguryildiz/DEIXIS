{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deixis.local/contracts/research/evidence-cell-draft.schema.json",
  "title": "EvidenceCellDraft",
  "description": "One source's answers to the evidence table columns in the StepInput's extraction_target. Evidence cites only passages of that source from the allowlist, each with an exact quote. Reading depth and locators come from backend Passage records. The states inaccessible, not_verified and not_reported are not model states. Passing structural checks is not semantic verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "step_input_id",
    "scope_revision",
    "skill_package_hash",
    "cells"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "deixis.evidence_cell_draft.v1" },
    "step_input_id": { "$ref": "common.schema.json#/$defs/step_input_id" },
    "scope_revision": { "$ref": "common.schema.json#/$defs/scope_revision" },
    "skill_package_hash": { "$ref": "common.schema.json#/$defs/skill_package_hash" },
    "cells": {
      "type": "array",
      "maxItems": 8,
      "description": "Exactly one item for each column in extraction_target.columns.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["column_id", "state", "value", "note", "evidence"],
        "properties": {
          "column_id": { "type": "string", "pattern": "^col_[0-9A-Za-z]{8,40}$" },
          "state": {
            "type": "string",
            "enum": ["value", "unknown", "not_applicable", "not_found_in_inspected_scope"],
            "description": "value: the passages state an answer. unknown: the passages address the column but do not settle it. not_applicable: the column does not apply to this source; the note says why. not_found_in_inspected_scope: the supplied passages do not address the column."
          },
          "value": {
            "description": "Non-null only for state value, shaped by the column's answer_format.",
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["option_ids"],
                "properties": {
                  "option_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": { "type": "string", "pattern": "^o[0-9]{1,3}$" }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["number", "unit", "as_stated"],
                "properties": {
                  "number": { "type": "number" },
                  "unit": { "type": ["string", "null"], "maxLength": 40 },
                  "as_stated": { "type": ["string", "null"], "maxLength": 200 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["answer"],
                "properties": {
                  "answer": { "type": "string", "enum": ["yes", "no"] }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["text"],
                "properties": {
                  "text": { "type": "string", "minLength": 1, "maxLength": 500 }
                }
              },
              { "type": "null" }
            ]
          },
          "note": {
            "type": ["string", "null"],
            "maxLength": 600,
            "description": "Short reason, required for not_applicable. No page, equation, table, figure or section numbers."
          },
          "evidence": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["passage_id", "quote"],
              "properties": {
                "passage_id": { "$ref": "common.schema.json#/$defs/passage_id" },
                "quote": { "type": "string", "minLength": 12, "maxLength": 600 }
              }
            }
          }
        }
      }
    }
  }
}
