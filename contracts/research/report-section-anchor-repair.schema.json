{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deixis.local/contracts/research/report-section-anchor-repair.schema.json",
  "title": "ReportSectionAnchorRepair",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "step_input_id", "scope_revision", "anchors", "claims"],
  "properties": {
    "schema_version": {"type": "string", "const": "deixis.report_section_anchor_repair.v1"},
    "step_input_id": {"$ref": "common.schema.json#/$defs/step_input_id"},
    "scope_revision": {"$ref": "common.schema.json#/$defs/scope_revision"},
    "anchors": {
      "type": "array", "minItems": 1, "maxItems": 300,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["anchor_index", "quote_number"],
        "properties": {
          "anchor_index": {"type": "integer", "minimum": 0},
          "quote_number": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    },
    "claims": {
      "type": "array", "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim_key", "text", "removed", "context", "reason"],
        "properties": {
          "claim_key": {"type": "string", "pattern": "^[A-Za-z_]+\\.[0-9]{1,3}$"},
          "text": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
          "removed": {"type": "boolean"},
          "context": {"type": ["string", "null"], "minLength": 1, "maxLength": 180, "pattern": "\\S"},
          "reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 600, "pattern": "\\S"}
        }
      }
    }
  }
}
