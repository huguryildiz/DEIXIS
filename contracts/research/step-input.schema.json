{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deixis.local/contracts/research/step-input.schema.json",
  "title": "StepInput",
  "description": "Immutable, re-readable snapshot of everything given to one model step. Backend-owned; never produced by a model. Output identifiers are checked against this step's allowlist, not against the shared library.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step_input_id",
    "research_id",
    "run_id",
    "step_id",
    "task_type",
    "scope_revision",
    "skill_package_hash",
    "skill_files",
    "output_schema_versions",
    "question",
    "user_steering",
    "capabilities",
    "enabled_providers",
    "candidates",
    "sources",
    "passages",
    "allowlist",
    "human_corrections",
    "budget",
    "model",
    "created_at"
  ],
  "properties": {
    "step_input_id": {
      "$ref": "common.schema.json#/$defs/step_input_id"
    },
    "research_id": {
      "type": "string",
      "pattern": "^res_[0-9A-Za-z]{8,40}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9A-Za-z]{8,40}$"
    },
    "step_id": {
      "type": "string",
      "pattern": "^stp_[0-9A-Za-z]{8,40}$"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "search_plan",
        "screening",
        "grounded_answer",
        "answer_review",
        "cell_extraction",
        "table_columns",
        "research_title",
        "report_plan",
        "report_section",
        "report_phrase_repair",
        "report_review"
      ]
    },
    "scope_revision": {
      "$ref": "common.schema.json#/$defs/scope_revision"
    },
    "skill_package_hash": {
      "$ref": "common.schema.json#/$defs/skill_package_hash"
    },
    "skill_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_schema_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "language_hint"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "language_hint": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/language_tag"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "user_steering": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_tasks",
        "unsupported_tasks"
      ],
      "properties": {
        "supported_tasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsupported_tasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "enabled_providers": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/provider_id"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "title",
          "year",
          "venue",
          "abstract",
          "abstract_origin",
          "identifiers"
        ],
        "properties": {
          "candidate_id": {
            "$ref": "common.schema.json#/$defs/candidate_id"
          },
          "title": {
            "type": "string"
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "venue": {
            "type": [
              "string",
              "null"
            ]
          },
          "abstract": {
            "type": [
              "string",
              "null"
            ]
          },
          "abstract_origin": {
            "type": [
              "string",
              "null"
            ]
          },
          "identifiers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "work_id",
          "title",
          "year",
          "version_label",
          "access_level"
        ],
        "properties": {
          "source_id": {
            "$ref": "common.schema.json#/$defs/source_id"
          },
          "work_id": {
            "type": "string",
            "pattern": "^wrk_[0-9A-Za-z]{8,40}$",
            "description": "Work family. Versions sharing a work_id are not independent evidence."
          },
          "title": {
            "type": "string"
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "version_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "access_level": {
            "type": "string",
            "enum": [
              "metadata",
              "abstract",
              "pdf_available",
              "inaccessible"
            ]
          }
        }
      }
    },
    "passages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "passage_id",
          "source_id",
          "reading_depth",
          "locator",
          "abstract_origin",
          "text_source",
          "text"
        ],
        "properties": {
          "passage_id": {
            "$ref": "common.schema.json#/$defs/passage_id"
          },
          "source_id": {
            "$ref": "common.schema.json#/$defs/source_id"
          },
          "reading_depth": {
            "type": "string",
            "enum": [
              "metadata",
              "abstract",
              "selected_sections",
              "full_text"
            ]
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "physical_page",
              "printed_label"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "abstract",
                  "pdf_page",
                  "section"
                ]
              },
              "physical_page": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "printed_label": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "abstract_origin": {
            "type": [
              "string",
              "null"
            ],
            "description": "Origin of abstract text (for example provider_openalex_inverted_index, publisher_pdf, user). Null for non-abstract passages."
          },
          "text_source": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "text_layer",
              "ocr",
              "marker",
              null
            ],
            "description": "How a PDF passage's text was obtained: the PDF's own text layer, local OCR of a scanned page, or Marker's reading of a page with mathematics (equations as LaTeX). OCR and Marker text can misread characters and symbols. Null for abstracts."
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "claims_under_review": {
      "type": "array",
      "description": "answer_review steps only: the claims of the answer being reviewed. Each claim's passages are in passages.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_label",
          "text",
          "support_type",
          "passage_ids"
        ],
        "properties": {
          "claim_label": {
            "type": "string",
            "pattern": "^c[0-9]{1,3}$"
          },
          "text": {
            "type": "string"
          },
          "support_type": {
            "type": "string",
            "enum": [
              "source_stated",
              "analyst_inference"
            ]
          },
          "passage_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/passage_id"
            }
          }
        }
      }
    },
    "extraction_target": {
      "type": "object",
      "description": "cell_extraction and table_columns steps only: the evidence table and its columns. A cell_extraction step reads the passages of source_id only; table_columns has no source_id or passage_scope.",
      "additionalProperties": false,
      "required": [
        "table_id",
        "source_id",
        "columns",
        "passage_scope"
      ],
      "properties": {
        "table_id": {
          "type": "string",
          "pattern": "^tbl_[0-9A-Za-z]{8,40}$"
        },
        "source_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/source_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "columns": {
          "type": "array",
          "description": "cell_extraction: the columns to answer. table_columns: the table's current columns.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "column_id",
              "revision",
              "name",
              "instruction",
              "answer_format",
              "options",
              "allow_multiple",
              "unit_hint"
            ],
            "properties": {
              "column_id": {
                "type": "string",
                "pattern": "^col_[0-9A-Za-z]{8,40}$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "name": {
                "type": "string"
              },
              "instruction": {
                "type": "string"
              },
              "answer_format": {
                "type": "string",
                "enum": [
                  "choice",
                  "number_unit",
                  "yes_no",
                  "text"
                ]
              },
              "options": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "label"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^o[0-9]{1,3}$"
                        },
                        "label": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "allow_multiple": {
                "type": "boolean"
              },
              "unit_hint": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "passage_scope": {
          "description": "How much of the source's stored text the step was given. all_pages_given: every extracted PDF passage was given, which is still not a reading of the whole publication.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "given",
                "available",
                "all_pages_given"
              ],
              "properties": {
                "given": {
                  "type": "integer",
                  "minimum": 0
                },
                "available": {
                  "type": "integer",
                  "minimum": 0
                },
                "all_pages_given": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "report_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "section_id", "columns", "plan", "cells", "gap_candidates", "prior_summaries", "repair_request", "review_scope"],
      "properties": {
        "report_id": { "type": "string", "pattern": "^rpt_[0-9A-Za-z]{8,40}$" },
        "section_id": {
          "anyOf": [{ "type": "string", "enum": ["I", "III", "IV", "V", "VI", "VII", "VIII", "IX", "abstract", "index_terms"] }, { "type": "null" }]
        },
        "columns": {
          "type": "array",
          "description": "The evidence table's columns, so the plan step can tie an axis to a real column and a section step can name one.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["column_id", "revision", "name", "instruction", "answer_format"],
            "properties": {
              "column_id": { "type": "string", "pattern": "^col_[0-9A-Za-z]{8,40}$" },
              "revision": { "type": "integer", "minimum": 1 },
              "name": { "type": "string" },
              "instruction": { "type": "string" },
              "answer_format": { "type": "string" }
            }
          }
        },
        "plan": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["scope_statement", "research_questions", "glossary", "axes", "limitations_column_id", "future_work_column_id", "corpus", "section_budgets", "allowed_support"],
              "properties": {
                "scope_statement": { "type": "string" },
                "research_questions": { "type": "array", "items": { "type": "object" } },
                "glossary": { "type": "array", "items": { "type": "object" } },
                "axes": { "type": "array", "items": { "type": "object" } },
                "limitations_column_id": { "anyOf": [{ "type": "string", "pattern": "^col_[0-9A-Za-z]{8,40}$" }, { "type": "null" }] },
                "future_work_column_id": { "anyOf": [{ "type": "string", "pattern": "^col_[0-9A-Za-z]{8,40}$" }, { "type": "null" }] },
                "corpus": {
                  "type": "object", "additionalProperties": false,
                  "required": ["found", "unique", "screened", "included", "full_text"],
                  "properties": {
                    "found": { "type": "integer" }, "unique": { "type": "integer" }, "screened": { "type": "integer" },
                    "included": { "type": "integer" }, "full_text": { "type": "integer" }
                  }
                },
                "section_budgets": {
                  "type": "object", "additionalProperties": { "type": "object", "required": ["min_words", "max_words", "max_claims"],
                    "additionalProperties": false, "properties": { "min_words": { "type": "integer" }, "max_words": { "type": "integer" }, "max_claims": { "type": "integer" } } }
                },
                "allowed_support": {
                  "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string", "enum": ["source_stated", "analyst_inference"] } }
                }
              }
            },
            { "type": "null" }
          ],
          "description": "report_plan (this validates the plan the model just wrote, before code appends corpus/section_budgets/allowed_support): null. report_section and report_phrase_repair: the frozen plan. report_review: null (review reads sections directly, not the plan echo)."
        },
        "cells": {
          "type": "array",
          "description": "Selected records from the frozen report snapshot. Cell and revision identifiers pin each value and its source-owned evidence quotes; an empty array is valid when a step needs no cells.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cell_id", "cell_revision_id", "column_id", "source_version_id", "state", "value", "reading_depth", "evidence"],
            "properties": {
              "cell_id": { "type": "string", "pattern": "^cel_[0-9A-Za-z]{8,40}$" },
              "cell_revision_id": { "type": "string", "pattern": "^crv_[0-9A-Za-z]{8,40}$" },
              "column_id": { "type": "string", "pattern": "^col_[0-9A-Za-z]{8,40}$" },
              "source_version_id": { "$ref": "common.schema.json#/$defs/source_id" },
              "state": { "type": "string", "enum": ["value", "unknown", "not_reported", "not_verified", "not_applicable", "inaccessible", "not_found_in_inspected_scope"] },
              "value": { "type": ["object", "null"] },
              "reading_depth": { "type": ["string", "null"], "enum": ["metadata", "abstract", "selected_sections", "full_text", null] },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["passage_id", "quote"],
                  "properties": {
                    "passage_id": { "$ref": "common.schema.json#/$defs/passage_id" },
                    "quote": { "type": ["string", "null"] }
                  }
                }
              }
            }
          }
        },
        "gap_candidates": {
          "type": "array",
          "description": "Code-generated corpus_absence candidates for VI from the same frozen cells; other steps receive an empty array. The model writes candidate prose but cannot mint this kind's basis.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gap_id", "kind", "column_id", "basis_cell_ids", "full_text_applicable_count", "summary_only_count"],
            "properties": {
              "gap_id": { "type": "string", "pattern": "^gap[0-9]{1,3}$" },
              "kind": { "type": "string", "const": "corpus_absence" },
              "column_id": { "type": "string", "pattern": "^col_[0-9A-Za-z]{8,40}$" },
              "basis_cell_ids": { "type": "array", "minItems": 3, "items": { "type": "string", "pattern": "^cel_[0-9A-Za-z]{8,40}$" } },
              "full_text_applicable_count": { "type": "integer", "minimum": 3 },
              "summary_only_count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "prior_summaries": {
          "type": "array",
          "description": "report_section only: code-written one-line summaries of already-valid sections this call may build on (§4: 'özetleri kod üretir').",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["section_id", "claim_key", "first_sentence", "support_type", "reading_depth"],
            "properties": {
              "section_id": { "type": "string" }, "claim_key": { "type": "string" }, "first_sentence": { "type": "string" },
              "support_type": { "type": "string", "enum": ["source_stated", "analyst_inference"] },
              "reading_depth": { "type": "string", "enum": ["metadata", "abstract", "selected_sections", "full_text"] }
            }
          }
        },
        "repair_request": {
          "anyOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["section_id", "sentences"],
              "properties": {
                "section_id": { "type": "string" },
                "sentences": {
                  "type": "array",
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["sentence_id", "text", "support_type", "nearest_frames", "previous_sentence", "next_sentence"],
                    "properties": {
                      "sentence_id": { "type": "string" }, "text": { "type": "string" },
                      "support_type": { "type": "string", "enum": ["source_stated", "analyst_inference"] },
                      "nearest_frames": { "type": "array", "maxItems": 3, "items": { "type": "string" } },
                      "previous_sentence": { "type": ["string", "null"] }, "next_sentence": { "type": ["string", "null"] }
                    }
                  }
                }
              }
            },
            { "type": "null" }
          ]
        },
        "review_scope": { "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "null" }] }
      }
    },
    "allowlist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_ids",
        "source_ids",
        "passage_ids"
      ],
      "properties": {
        "candidate_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/candidate_id"
          }
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/source_id"
          }
        },
        "column_ids": { "type": "array", "items": { "type": "string", "pattern": "^col_[0-9A-Za-z]{8,40}$" } },
        "cell_ids": { "type": "array", "items": { "type": "string", "pattern": "^cel_[0-9A-Za-z]{8,40}$" } },
        "gap_ids": { "type": "array", "items": { "type": "string", "pattern": "^gap[0-9]{1,3}$" } },
        "passage_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/passage_id"
          }
        }
      }
    },
    "human_corrections": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_model_calls",
        "max_schema_repairs",
        "max_provider_requests"
      ],
      "properties": {
        "max_model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_schema_repairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "max_provider_requests": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection",
        "requested_model"
      ],
      "properties": {
        "connection": {
          "type": "string",
          "enum": [
            "codex",
            "claude",
            "deepseek",
            "gemini",
            "ollama",
            "fake"
          ]
        },
        "requested_model": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "created_at": {
      "type": "string"
    }
  }
}
