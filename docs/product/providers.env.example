# Variable names only. No credentials were transferred from the conversation.
# Configure replacement credentials locally; never publish filled copies.
# Settings › Connections can store the model and source keys below in the system keychain instead (D29);
# a key set here or in the shell wins and cannot be changed from the app.
S2_API_KEY=
OPENALEX_API_KEY=
# Optional; PubMed works keyless, while an NCBI key permits higher E-utilities request rates.
NCBI_API_KEY=
SCOPUS_API_KEY=
IEEE_API_KEY=
SERPAPI_API_KEY=
# CORE search and PDF lookup by DOI (D31).
CORE_API_KEY=
# Zotero collection import from zotero.org (D16), with pyzotero's names; the Zotero app on this computer needs no key.
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=
# user (default) or group
ZOTERO_LIBRARY_TYPE=
# Gemini API model connection and semantic passage retrieval (D26, D27). Passage text is sent to Google when set.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# OpenAI API, used only for semantic passage retrieval when chosen in Settings (D29). Passage text is sent to OpenAI.
OPENAI_API_KEY=
# Model/agent configuration remains undecided and separate from search access.
